---
import Logo from './Logo.astro';
import { site } from '../data/site';
interface Props { theme?: 'light' | 'dark' }
const { theme = 'light' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === '/' || path === '/index.html';
  const base = href.split('#')[0];
  return base !== '/' && path.startsWith(base);
};
const menu = site.nav.filter((n) => n.label !== '상담 문의');
---

<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent"
  data-theme={theme}
  data-solid="false"
>
  <div class="container-x flex h-[64px] items-center justify-between">
    <Logo variant="auto" />

    <nav class="hidden items-center gap-7 md:flex" aria-label="주 메뉴">
      {menu.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-[0.92rem] font-medium transition-opacity hover:opacity-100',
            isActive(item.href) ? 'opacity-100' : 'opacity-70',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/#inquiry"
        class="ml-1 inline-flex items-center rounded-full bg-wine px-4.5 py-2 text-[0.88rem] font-semibold text-white transition-colors hover:bg-wine-2"
      >
        상담신청
      </a>
    </nav>

    <button
      id="nav-toggle"
      class="grid size-11 place-items-center md:hidden"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="relative block h-[12px] w-[22px]">
        <span class="nav-bar absolute inset-x-0 top-0 h-[2px] bg-current transition-all duration-300"></span>
        <span class="nav-bar absolute inset-x-0 bottom-0 h-[2px] bg-current transition-all duration-300"></span>
      </span>
    </button>
  </div>

  <div
    id="mobile-nav"
    class="pointer-events-none max-h-0 overflow-hidden bg-white text-ink opacity-0 transition-all duration-500 ease-out-expo md:hidden"
    aria-hidden="true"
  >
    <nav class="container-x flex flex-col py-4" aria-label="모바일 메뉴">
      {menu.map((item) => (
        <a href={item.href} class="border-b border-line py-4 text-lg font-semibold" aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a href="/#inquiry" class="mt-4 inline-flex items-center justify-center rounded-full bg-wine py-3.5 font-semibold text-white">상담신청</a>
      <a href={site.phoneHref} class="mt-2 inline-flex items-center justify-center rounded-full border border-line py-3.5 font-semibold">{site.phone} 전화 상담</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('nav-toggle')!;
  const mobile = document.getElementById('mobile-nav')!;
  const bars = toggle.querySelectorAll<HTMLElement>('.nav-bar');

  const update = () => header.setAttribute('data-solid', String(window.scrollY > 24 || mobile.dataset.open === 'true'));
  update();
  window.addEventListener('scroll', update, { passive: true });

  toggle.addEventListener('click', () => {
    const open = mobile.dataset.open !== 'true';
    mobile.dataset.open = String(open);
    mobile.classList.toggle('max-h-0', !open);
    mobile.classList.toggle('max-h-[80vh]', open);
    mobile.classList.toggle('opacity-0', !open);
    mobile.classList.toggle('pointer-events-none', !open);
    mobile.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    bars[0].style.transform = open ? 'translateY(5px) rotate(45deg)' : '';
    bars[1].style.transform = open ? 'translateY(-5px) rotate(-45deg)' : '';
    update();
  });
  mobile.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle.dispatchEvent(new Event('click'))));
</script>
