---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import logoWhite from '../assets/logo-white.png';

/**
 * 로고 이미지 (원본 images/logo.png).
 * variant:
 *  - 'color': 원본(검정 워드마크) — 밝은 배경용
 *  - 'white': 흰 워드마크 — 어두운 배경용
 *  - 'auto' : 헤더 전용. 다크 히어로 위(data-solid=false)에선 white, 스크롤로 흰 배경이 되면 color
 */
interface Props { class?: string; variant?: 'auto' | 'color' | 'white' }
const { class: cls = '', variant = 'color' } = Astro.props;
const imgAttrs = { alt: '주성회계법인', width: 566, height: 113, loading: 'eager' as const, class: 'h-8 w-auto' };
---

<a href="/" class:list={['inline-flex items-center', cls]} aria-label="주성회계법인 홈">
  {variant === 'color' && <Image src={logo} {...imgAttrs} />}
  {variant === 'white' && <Image src={logoWhite} {...imgAttrs} />}
  {variant === 'auto' && (
    <>
      <Image src={logo} {...imgAttrs} class={`${imgAttrs.class} logo-color`} />
      <Image src={logoWhite} {...imgAttrs} class={`${imgAttrs.class} logo-white`} />
    </>
  )}
</a>
