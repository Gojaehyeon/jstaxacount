---
import Button from './Button.astro';
import { site } from '../data/site';
interface Props { title?: string; lead?: string }
const {
  title = '고객 한 분만을 위한 프라이빗 상담',
  lead = '복잡한 세무·회계 문제일수록 첫 상담이 중요합니다. 문의를 남기시면 담당 회계사가 직접 답변드립니다.',
} = Astro.props;
---

<section class="bg-dark text-white">
  <div class="container-x flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between md:py-20">
    <div class="reveal">
      <h2 class="display dot text-[1.7rem] sm:text-[2.1rem]" set:html={title} />
      <p class="mt-3 max-w-xl text-[0.98rem] leading-7 text-white/60">{lead}</p>
    </div>
    <div class="reveal flex shrink-0 flex-col gap-3 sm:flex-row" style="--reveal-delay:100ms">
      <Button href="/#inquiry" variant="primary" size="lg">상담신청</Button>
      <Button href={site.phoneHref} variant="ghost-dark" size="lg">{site.phone}</Button>
    </div>
  </div>
</section>
