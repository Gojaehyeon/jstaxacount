---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'ghost-dark' | 'gold';
  class?: string;
  size?: 'md' | 'lg';
}
const { href, variant = 'primary', class: cls = '', size = 'md' } = Astro.props;
const base = 'group inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-300 ease-out-expo';
const sizes = { md: 'px-6 py-3 text-[0.92rem]', lg: 'px-8 py-3.5 text-[0.98rem]' };
const variants = {
  primary: 'bg-wine text-white hover:bg-wine-2',
  gold: 'bg-wine text-white hover:bg-wine-2',
  ghost: 'border border-ink/20 text-ink hover:border-ink',
  'ghost-dark': 'border border-white/30 text-white hover:border-white',
};
---

<a href={href} class:list={[base, sizes[size], variants[variant], cls]}>
  <slot />
  <svg
    class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
    ><path d="M5 12h14M13 6l6 6-6 6" /></svg
  >
</a>
