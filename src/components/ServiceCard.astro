---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { service: CollectionEntry<'services'>; index: number }
const { service, index } = Astro.props;
const d = service.data;
---

<a
  href={`/services.html#${service.id}`}
  class="reveal group relative flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-line transition-all duration-500 ease-out-expo hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgba(22,18,15,0.35)]"
  style={`--reveal-delay:${index * 80}ms`}
>
  <div class="relative aspect-[16/10] overflow-hidden">
    <Image
      src={d.image}
      alt={d.title}
      width={720}
      height={450}
      class="size-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.04]"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/50 to-transparent"></div>
    <span class="eyebrow absolute bottom-4 left-5 !text-gold-2">{d.eyebrow}</span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="display text-[1.35rem]">{d.title}</h3>
    <p class="mt-2 flex-1 text-[0.95rem] leading-7 text-stone">{d.description}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {d.groups[0].items.slice(0, 3).map((item) => (
        <li class="rounded-full bg-paper-2 px-3 py-1 text-[0.78rem] font-medium text-ink-2">{item}</li>
      ))}
    </ul>
    <span class="mt-6 inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-wine">
      자세히 보기
      <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
