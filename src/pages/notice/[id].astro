---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const notices = await getCollection('notices');
  return notices.map((n) => ({ params: { id: n.id }, props: { notice: n } }));
}
const { notice } = Astro.props;
const { Content } = await render(notice);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: notice.data.title,
  datePublished: notice.data.date.toISOString(),
  description: notice.data.summary,
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
};
---

<Base title={notice.data.title} description={notice.data.summary} jsonLd={jsonLd}>
  <article class="pt-36 pb-20 md:pb-28">
    <div class="container-x max-w-3xl">
      <a href="/notice.html" class="inline-flex items-center gap-1.5 text-[0.9rem] font-medium text-stone hover:text-wine">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
        공지사항 목록
      </a>
      <header class="mt-8 border-b border-line pb-8">
        <div class="flex items-center gap-3 text-[0.85rem]">
          <span class="rounded-full bg-paper-2 px-2.5 py-0.5 font-medium text-ink-2">{notice.data.category}</span>
          <time datetime={notice.data.date.toISOString()} class="font-serif text-[1rem] text-stone-2">{fmt(notice.data.date)}</time>
        </div>
        <h1 class="display mt-4 text-[1.9rem] sm:text-[2.5rem]">{notice.data.title}</h1>
        <p class="mt-4 leading-7 text-stone">{notice.data.summary}</p>
      </header>
      <div class="prose-note mt-8 text-[1.02rem]">
        <Content />
      </div>
    </div>
  </article>
  <CTA />
</Base>
