---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Stats from '../components/Stats.astro';
import Contact from '../components/Contact.astro';
import Inquiry from '../components/Inquiry.astro';
import hero from '../assets/hero.jpg';
import tax1 from '../assets/services/tax1.jpg';
import tax2 from '../assets/services/tax2.jpg';
import tax3 from '../assets/services/tax3.jpg';
import { site } from '../data/site';
import { serviceCards } from '../data/service-cards';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const notices = (await getCollection('notices'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const noticeImages = [tax1, tax2, tax3];
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');

const difference = [
  ['자산가의 재무를\n깊이 이해하는 팀', '대형회계법인, 금융회사, 대기업에서 실무를 쌓은 구성원들이 상속·증여, 투자, 승계 등 자산가와 기업이 마주하는 재무 과제를 선제적으로 파악합니다.'],
  ['기장부터 미국 세무까지,\n하나의 창구', '회계감사, 세무자문, 프라이빗 웰쓰, 미국 세무, 재무자문까지. 사업과 자산의 전 여정에서 만나는 재무 이슈를 한 곳에서 해결할 수 있습니다.'],
  ['1,200건 이상,\n검증된 상담 실적', '누적 상담 1,200건 이상. 고객 한 분만을 위한 프라이빗 서비스로 축적한 실전 노하우를 바탕으로 최적의 솔루션을 제시합니다.'],
  ['국경을 넘는\n크로스보더 전문성', '미국 공인회계사 자문역과의 협업으로 한국–미국 간 상속·증여, 이민 전후 세금 플래닝, 미국 진출 법인 운영까지 지원합니다.'],
];
---

<Base headerTheme="dark">
  <!-- ===== Hero ===== -->
  <section class="relative isolate flex min-h-[86svh] items-center justify-center overflow-hidden bg-dark text-white">
    <Image
      src={hero}
      alt=""
      widths={[720, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-20 size-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 -z-10 bg-black/45" aria-hidden="true"></div>

    <div class="container-x relative pt-24 pb-20 text-center">
      <h1 class="reveal display text-[2.4rem] leading-[1.25] sm:text-[3.4rem] lg:text-[3.9rem]">
        사업의 시작부터<br />기업의 정점까지<span class="text-wine-3">.</span>
      </h1>
      <p class="reveal mt-6 text-[1.02rem] text-white/75 sm:text-[1.12rem]" style="--reveal-delay:120ms">
        고객 한 분만을 위한 프라이빗 회계·세무 서비스
      </p>
    </div>

    <a
      href="#statement"
      class="absolute bottom-8 left-1/2 grid size-11 -translate-x-1/2 place-items-center rounded-full border border-white/40 text-white/80 transition-colors hover:border-white"
      aria-label="아래로 이동"
    >
      <svg class="size-4 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
    </a>
  </section>

  <!-- ===== Statement + Stats ===== -->
  <section id="statement" class="scroll-mt-16 py-24 md:py-32">
    <div class="container-x">
      <h2 class="reveal display mx-auto max-w-3xl text-center text-[1.7rem] leading-snug sm:text-[2.3rem]">
        측정되지 않은 것은 관리되지 않습니다<span class="text-wine">.</span><br />
        숫자에서 출발해 재무적 의사결정 전체를 함께 설계합니다<span class="text-wine">.</span>
      </h2>
      <Stats class="mx-auto mt-16 max-w-4xl" />
    </div>
  </section>

  <!-- ===== Difference ===== -->
  <section class="bg-paper-2 py-20 md:py-28">
    <div class="container-x">
      <SectionHead title="Difference" dot={false} />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {difference.map(([t, d], i) => (
          <div class="reveal rounded-[4px] bg-white p-8 sm:p-10" style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <p class="text-[0.95rem] font-bold text-wine">0{i + 1}</p>
            <h3 class="mt-4 text-[1.3rem] leading-snug font-bold whitespace-pre-line sm:text-[1.45rem]">{t}</h3>
            <p class="mt-4 max-w-xl text-[0.95rem] leading-7 text-stone">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== People (dark band) ===== -->
  <section class="bg-dark py-20 text-white md:py-24">
    <div class="container-x">
      <SectionHead title="People" dot={false} invert lead="대형회계법인·금융회사·대기업에서 검증된 전문가들이 함께합니다." />
    </div>
    <div class="no-scrollbar mt-10 flex snap-x gap-4 overflow-x-auto px-5 sm:px-8" style="scroll-padding-left: 2rem">
      {team.map((m) => (
        <a
          href={`/about.html#member-${m.id}`}
          class="group relative w-[220px] shrink-0 snap-start overflow-hidden rounded-[4px] bg-[#222] sm:w-[250px]"
        >
          <Image
            src={m.data.photo}
            alt={`${m.data.title} ${m.data.name}`}
            width={500}
            height={620}
            class="aspect-[4/5] w-full object-cover object-top opacity-90 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-4 pt-10">
            <p class="font-bold">
              {m.data.name}
              {m.data.role === '자문역' && <span class="ml-1.5 rounded-[3px] bg-wine px-1.5 py-0.5 align-middle text-[0.65rem] font-semibold">자문</span>}
            </p>
            <p class="mt-0.5 text-[0.75rem] text-white/60">{m.data.title}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="container-x mt-8">
      <a href="/about.html#team" class="reveal inline-flex items-center gap-2 text-[0.92rem] font-semibold text-white/80 hover:text-white">
        구성원 전체 보기
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section class="py-20 md:py-28">
    <div class="container-x">
      <SectionHead title="Services" dot={false} lead={`사업과 자산의 전 여정에 필요한 ${serviceCards.length}개 서비스를 제공합니다.`} />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {serviceCards.map((c, i) => (
          <a
            href={c.href}
            class="reveal group flex flex-col justify-between rounded-[4px] border border-line bg-white p-6 transition-colors duration-300 hover:border-ink"
            style={`--reveal-delay:${(i % 4) * 60}ms`}
          >
            <div>
              <h3 class="dot text-[1.25rem] font-bold tracking-tightest">{c.title}</h3>
              <p class="mt-3 text-[0.88rem] leading-6 text-stone">{c.desc}</p>
            </div>
            <svg class="mt-8 size-6 text-ink transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Insight / Notice ===== -->
  <section class="bg-paper-2 py-20 md:py-28">
    <div class="container-x">
      <div class="flex items-end justify-between">
        <SectionHead title="Insight" dot={false} lead="세무·회계 소식과 공지사항을 안내드립니다." />
        <a href="/notice.html" class="reveal hidden shrink-0 items-center gap-2 text-[0.92rem] font-semibold hover:text-wine sm:inline-flex">
          Learn more
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {notices.map((n, i) => (
          <a href={`/notice/${n.id}.html`} class="reveal group relative aspect-[4/3] overflow-hidden rounded-[4px]" style={`--reveal-delay:${i * 80}ms`}>
            <Image src={noticeImages[i]} alt="" width={640} height={480} class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-[1.04]" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-black/10"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 text-white">
              <p class="text-[0.75rem] font-semibold text-wine-3">{n.data.category} · {fmt(n.data.date)}</p>
              <h3 class="mt-1.5 text-[1.1rem] leading-snug font-bold">{n.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <a href="/notice.html" class="mt-8 inline-flex items-center gap-2 text-[0.92rem] font-semibold hover:text-wine sm:hidden">
        Learn more
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>

  <Inquiry />
  <Contact />
</Base>
