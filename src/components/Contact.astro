---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { site, parking } from '../data/site';

const parkingImages = import.meta.glob<{ default: ImageMetadata }>('../assets/parking/*.png', { eager: true });
const img = (name: string) => parkingImages[`../assets/parking/${name}.png`].default;
const mapId = `daumRoughmapContainer${site.daumRoughmap.timestamp}`;
---

<section id="contact" class="scroll-mt-20 bg-paper-2 py-20 md:py-28">
  <div class="container-x">
    <SectionHead eyebrow="Location" title="Location" lead="강남구 논현로 616, 4층. 방문 전 전화로 예약하시면 대기 없이 상담이 가능합니다." />

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
      <div class="reveal map-frame relative overflow-hidden rounded-[4px] bg-white ring-1 ring-line">
        <div id={mapId} class="root_daum_roughmap root_daum_roughmap_landing" style="width:100%;height:100%"></div>
        <noscript>
          <div class="absolute inset-0 grid place-items-center p-6 text-center text-stone">지도를 보려면 자바스크립트를 활성화하시기 바랍니다.</div>
        </noscript>
      </div>

      <div class="reveal flex flex-col justify-between rounded-[4px] bg-dark p-7 text-white sm:p-8" style="--reveal-delay:120ms">
        <dl class="space-y-5">
          {[
            ['주소', site.address, undefined],
            ['대표번호', site.phone, site.phoneHref],
            ['팩스', site.fax, undefined],
            ['이메일', site.email, `mailto:${site.email}`],
            ['업무시간', site.hours, undefined],
          ].map(([k, v, href]) => (
            <div>
              <dt class="text-[0.72rem] font-bold tracking-[0.14em] uppercase text-wine-3">{k}</dt>
              <dd class="mt-1 text-[1.05rem] leading-7">{href ? <a class="hover:text-gold" href={href}>{v}</a> : v}</dd>
            </div>
          ))}
        </dl>
        <a
          href={`https://map.kakao.com/link/search/${encodeURIComponent(site.address)}`}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 text-[0.9rem] font-semibold text-white/80 hover:text-white"
        >
          카카오맵에서 길찾기
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
      </div>
    </div>

    <div class="mt-16">
      <div class="reveal flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <h3 class="display text-[1.5rem]">주차 안내</h3>
        <p class="max-w-xl text-[0.95rem] leading-7 text-stone">
          30분 이내 방문은 건물 앞 주차장을 이용하실 수 있습니다. 상담 방문의 경우 아래 인근 유료 주차장을 이용해 주시기 바랍니다.
        </p>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {parking.map((p, i) => (
          <li class="reveal overflow-hidden rounded-[4px] bg-white ring-1 ring-line" style={`--reveal-delay:${i * 80}ms`}>
            <Image src={img(p.image)} alt={`${p.name} 약도`} width={480} height={360} class="aspect-[4/3] w-full object-cover" loading="lazy" />
            <div class="p-5">
              <p class="font-semibold">{p.name}</p>
              <p class="mt-1 text-[0.9rem] text-stone">{p.address}</p>
              <p class="mt-2 text-[0.8rem] text-stone-2">{p.note}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script is:inline define:vars={{ ts: site.daumRoughmap.timestamp, key: site.daumRoughmap.key, cdn: site.daumRoughmap.cdn, mapId }}>
  // 카카오(다음) 약도 위젯 — 오시는 길 섹션이 화면에 가까워질 때만 로드합니다(초기 로딩 성능 보호).
  // 공식 로더(roughmapLoader.js)는 document.write 를 사용해 지연 로드가 불가능하므로, 로더가 하는 일을 그대로 수행합니다.
  // 위젯 설정은 src/data/site.ts 의 daumRoughmap 값을 수정하십시오.
  (function () {
    var target = document.getElementById(mapId);
    if (!target) return;
    var loaded = false;
    function showFallback() {
      target.innerHTML =
        '<div style="display:grid;place-items:center;height:100%;padding:24px;text-align:center;color:#6b635b;font-size:.95rem;line-height:1.7">' +
        '지도를 불러오지 못했습니다.<br><a href="https://map.kakao.com/link/search/' + encodeURIComponent('서울 강남구 논현로 616') +
        '" target="_blank" rel="noopener" style="color:#4f1111;font-weight:600;text-decoration:underline">카카오맵에서 위치 보기</a></div>';
    }
    function loadMap() {
      if (loaded) return;
      loaded = true;
      window.daum = window.daum || {};
      if (!window.daum.roughmap) {
        window.daum.roughmap = {
          phase: 'prod',
          cdn: cdn,
          URL_KEY_DATA_LOAD_PRE: 'https://t1.kakaocdn.net/roughmap/',
          url_protocal: 'https:',
          url_cdn_domain: '//t1.kakaocdn.net',
        };
      }
      var s = document.createElement('script');
      s.charset = 'UTF-8';
      s.src = 'https://t1.kakaocdn.net/kakaomapweb/roughmap/place/prod/' + cdn + '/roughmapLander.js';
      s.onload = function () {
        try {
          new window.daum.roughmap.Lander({ timestamp: ts, key: key, info: false }).render();
        } catch (e) {
          showFallback();
        }
      };
      s.onerror = showFallback;
      document.body.appendChild(s);
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); loadMap(); }
      }, { rootMargin: '600px 0px' });
      io.observe(target);
    } else {
      loadMap();
    }
  })();
</script>
