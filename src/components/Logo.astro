---
/** 로고: 다크/라이트 배경 모두에서 선명하도록 HTML+CSS로 구성 */
interface Props { class?: string; compact?: boolean }
const { class: cls = '', compact = false } = Astro.props;
---

<a href="/" class:list={['group inline-flex items-center gap-2.5', cls]} aria-label="주성회계법인 홈">
  <span
    class="grid size-9 shrink-0 place-items-center rounded-[4px] bg-brand text-[14px] font-bold tracking-[0.02em] text-white"
    aria-hidden="true">主成</span
  >
  <span class="flex flex-col leading-none">
    <span class="text-[1.05rem] font-bold tracking-tightest">주성회계법인</span>
    {!compact && (
      <span class="mt-0.5 text-[0.62rem] font-semibold tracking-[0.14em] uppercase opacity-50">Juseong Accounting Firm</span>
    )}
  </span>
</a>
