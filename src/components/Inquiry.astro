---
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';
const { inquiry } = site;
---

<section id="inquiry" class="scroll-mt-16 bg-white py-20 md:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div>
      <SectionHead eyebrow="Inquiry" title="Contact" lead="문의 내용을 남겨 주시면 담당 회계사가 확인 후 영업일 기준 1일 이내에 연락드립니다. 급한 사안은 대표번호로 전화 주시기 바랍니다." />
      <dl class="reveal mt-10 space-y-5" style="--reveal-delay:120ms">
        <div>
          <dt class="text-[0.72rem] font-bold tracking-[0.14em] uppercase text-wine">Phone</dt>
          <dd class="mt-1 text-[1.4rem] font-semibold tracking-tightest"><a class="hover:text-wine" href={site.phoneHref}>{site.phone}</a></dd>
        </div>
        <div>
          <dt class="text-[0.72rem] font-bold tracking-[0.14em] uppercase text-wine">Email</dt>
          <dd class="mt-1 text-[1.05rem]"><a class="hover:text-wine" href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt class="text-[0.72rem] font-bold tracking-[0.14em] uppercase text-wine">Hours</dt>
          <dd class="mt-1 text-[1.05rem] text-stone">{site.hours}</dd>
        </div>
      </dl>
    </div>

    <form
      id="inquiry-form"
      class="reveal grid gap-5 rounded-[4px] bg-paper-2 p-6 sm:grid-cols-2 sm:p-8"
      style="--reveal-delay:160ms"
      novalidate
      data-endpoint={inquiry.endpoint}
      data-access-key={inquiry.accessKey}
      data-to={inquiry.to}
    >
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <label class="grid gap-1.5 text-[0.9rem] font-medium">
        <span>성함 <span class="text-wine">*</span></span>
        <input name="name" type="text" required autocomplete="name" class="field" placeholder="홍길동" />
      </label>
      <label class="grid gap-1.5 text-[0.9rem] font-medium">
        <span>연락처 <span class="text-wine">*</span></span>
        <input name="phone" type="tel" required autocomplete="tel" class="field" placeholder="010-0000-0000" />
      </label>
      <label class="grid gap-1.5 text-[0.9rem] font-medium">
        <span>이메일</span>
        <input name="email" type="email" autocomplete="email" class="field" placeholder="name@example.com" />
      </label>
      <label class="grid gap-1.5 text-[0.9rem] font-medium">
        <span>문의 분야 <span class="text-wine">*</span></span>
        <select name="topic" required class="field">
          <option value="" disabled selected>선택하시기 바랍니다</option>
          {inquiry.topics.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
      <label class="grid gap-1.5 text-[0.9rem] font-medium sm:col-span-2">
        <span>문의 내용 <span class="text-wine">*</span></span>
        <textarea name="message" required rows="5" class="field resize-y" placeholder="현재 상황과 궁금하신 점을 간단히 적어 주시기 바랍니다."></textarea>
      </label>
      <label class="flex items-start gap-3 text-[0.85rem] leading-6 text-stone sm:col-span-2">
        <input name="consent" type="checkbox" required class="mt-1.5 size-4 accent-wine" />
        <span>
          <span class="font-medium text-ink">개인정보 수집·이용에 동의합니다.</span> <span class="text-wine">*</span><br />
          수집 항목: 성함, 연락처, 이메일, 문의 내용 · 목적: 상담 회신 · 보유 기간: 문의 처리 완료 후 1년. 동의를 거부하실 수 있으며, 거부 시 온라인 문의가 제한됩니다.
        </span>
      </label>
      <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
        <p id="inquiry-status" class="text-[0.9rem] text-stone" aria-live="polite"></p>
        <button type="submit" class="group inline-flex items-center justify-center gap-2 rounded-full bg-wine px-7 py-3.5 font-semibold text-white transition-colors duration-300 hover:bg-wine-2 disabled:cursor-not-allowed disabled:opacity-60">
          문의 보내기
          <svg class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </form>
  </div>
</section>


<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const status = document.getElementById('inquiry-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (data.get('botcheck')) return; // 스팸 봇

    const fields = {
      name: String(data.get('name')),
      phone: String(data.get('phone')),
      email: String(data.get('email') || ''),
      topic: String(data.get('topic')),
      message: String(data.get('message')),
    };
    const { endpoint, accessKey, to } = form.dataset;

    // 접근 키가 없으면 메일 앱으로 대체 전송
    if (!accessKey) {
      const body = `성함: ${fields.name}\n연락처: ${fields.phone}\n이메일: ${fields.email}\n문의 분야: ${fields.topic}\n\n${fields.message}`;
      location.href = `mailto:${to}?subject=${encodeURIComponent(`[홈페이지 문의] ${fields.topic} - ${fields.name}`)}&body=${encodeURIComponent(body)}`;
      status.textContent = '메일 앱이 열립니다. 전송 버튼을 눌러 주시기 바랍니다.';
      return;
    }

    button.disabled = true;
    status.textContent = '전송 중입니다…';
    try {
      const res = await fetch(endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `[홈페이지 문의] ${fields.topic} - ${fields.name}`,
          from_name: '주성회계법인 홈페이지',
          ...fields,
        }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || res.statusText);
      form.reset();
      status.textContent = '문의가 접수되었습니다. 영업일 기준 1일 이내에 연락드리겠습니다.';
    } catch (err) {
      status.textContent = `전송에 실패했습니다. 대표번호로 연락 주시기 바랍니다. (${(err as Error).message})`;
    } finally {
      button.disabled = false;
    }
  });
</script>
