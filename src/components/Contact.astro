---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { site, parking } from '../data/site';

const parkingImages = import.meta.glob<{ default: ImageMetadata }>('../assets/parking/*.png', { eager: true });
const img = (name: string) => parkingImages[`../assets/parking/${name}.png`].default;
const mapId = `daumRoughmapContainer${site.daumRoughmap.timestamp}`;
---

<section id="contact" class="scroll-mt-20 bg-paper-2 py-20 md:py-28">
  <div class="container-x">
    <SectionHead eyebrow="Location" title="오시는 길" lead="강남구 논현로 616, 4층. 방문 전 전화로 예약하시면 대기 없이 상담이 가능합니다." />

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
      <div class="reveal map-frame relative overflow-hidden rounded-2xl bg-white ring-1 ring-line">
        <div id={mapId} class="root_daum_roughmap root_daum_roughmap_landing" style="width:100%;height:100%"></div>
        <noscript>
          <div class="absolute inset-0 grid place-items-center p-6 text-center text-stone">지도를 보려면 자바스크립트를 활성화하시기 바랍니다.</div>
        </noscript>
      </div>

      <div class="reveal flex flex-col justify-between rounded-2xl bg-ink p-7 text-white sm:p-8" style="--reveal-delay:120ms">
        <dl class="space-y-5">
          {[
            ['주소', site.address, undefined],
            ['대표번호', site.phone, site.phoneHref],
            ['팩스', site.fax, undefined],
            ['이메일', site.email, `mailto:${site.email}`],
            ['업무시간', site.hours, undefined],
          ].map(([k, v, href]) => (
            <div>
              <dt class="font-serif text-[0.8rem] italic tracking-[0.16em] uppercase text-gold-2">{k}</dt>
              <dd class="mt-1 text-[1.05rem] leading-7">{href ? <a class="hover:text-gold" href={href}>{v}</a> : v}</dd>
            </div>
          ))}
        </dl>
        <a
          href={`https://map.kakao.com/link/search/${encodeURIComponent(site.address)}`}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 text-[0.9rem] font-semibold text-gold-2 hover:text-gold"
        >
          카카오맵에서 길찾기
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
        </a>
      </div>
    </div>

    <div class="mt-16">
      <div class="reveal flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <h3 class="display text-[1.5rem]">주차 안내</h3>
        <p class="max-w-xl text-[0.95rem] leading-7 text-stone">
          30분 이내 방문은 건물 앞 주차장을 이용하실 수 있습니다. 상담 방문의 경우 아래 인근 유료 주차장을 이용해 주시기 바랍니다.
        </p>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {parking.map((p, i) => (
          <li class="reveal overflow-hidden rounded-2xl bg-white ring-1 ring-line" style={`--reveal-delay:${i * 80}ms`}>
            <Image src={img(p.image)} alt={`${p.name} 약도`} width={480} height={360} class="aspect-[4/3] w-full object-cover" loading="lazy" />
            <div class="p-5">
              <p class="font-semibold">{p.name}</p>
              <p class="mt-1 text-[0.9rem] text-stone">{p.address}</p>
              <p class="mt-2 text-[0.8rem] text-stone-2">{p.note}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script is:inline charset="UTF-8" class="daum_roughmap_loader_script" src="https://ssl.daumcdn.net/dmaps/map_js_init/roughmapLoader.js"></script>
<script is:inline define:vars={{ ts: site.daumRoughmap.timestamp, key: site.daumRoughmap.key }}>
  // 카카오(다음) 약도 위젯 — 위젯 설정은 src/data/site.ts 의 daumRoughmap 값을 수정하십시오.
  window.addEventListener('load', function () {
    if (window.daum && window.daum.roughmap) {
      new window.daum.roughmap.Lander({ timestamp: ts, key: key, info: false }).render();
    }
  });
</script>
